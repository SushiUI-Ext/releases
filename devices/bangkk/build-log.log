source ./envsetup.sh
case "$MAINTAINER" in *[!A-Za-z0-9._[:space:]-]*) echo "E: invalid MAINTAINER" >&2; exit 1;; esac
echo "Building 1.1.2-OFFICIAL by bangkkuser"
